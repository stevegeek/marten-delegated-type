# Rails-style `delegated_type :foo, types: [...]` on top of Marten's
# `field :foo, :polymorphic, to: [...]`.
#
# Marten's polymorphic field already auto-generates per-type sugar
# accessors named `<type>_<field>` (so for a polymorphic field named
# `leafable` with `to: [Page, Section, Picture]` you get `page_leafable`,
# `section_leafable`, `picture_leafable`). Rails' `delegated_type` exposes
# them under the shorter `<type>` form (`leaf.page`, `leaf.section`,
# `leaf.picture`). This macro emits the rename plus matching `?`
# predicates so the model class definition reads like the Rails original:
#
#   class Leaf < Marten::Model
#     include MartenDelegatedType
#
#     field :leafable, :polymorphic, to: [Page, Section, Picture]
#     delegated_type :leafable, types: [Page, Section, Picture]
#   end
#
# Now `leaf.page`, `leaf.page?`, `leaf.section`, `leaf.section?`,
# `leaf.picture`, `leaf.picture?` are available — each delegating to the
# corresponding `<type>_<field>` accessor generated by Marten's
# polymorphic field. A class-level pluralized scope is also exposed
# (`Leaf.pages`, `Leaf.sections`, `Leaf.pictures`) that delegates to
# Marten's `with_<short>_<field>` query helper.
#
# `include MartenDelegatedType` on the host model is load-bearing even
# though the module is otherwise empty: Crystal only propagates macros
# defined inside a module to a type when that type includes the module.
# Removing the include silently drops the `delegated_type` macro from
# the host's method-resolution scope.
module MartenDelegatedType
  # Defines short-form aliases for a polymorphic field's per-type accessors.
  #
  # Parameters:
  #   `field` — the name of an existing `:polymorphic` field on the host model.
  #   `types` — an `ArrayLiteral` of model classes; must be a subset of the
  #             polymorphic field's `to:` list.
  #   `as`    — optional `ArrayLiteral` of `String`/`Symbol` aliases parallel
  #             to `types:` (same length). When omitted, the alias is derived
  #             from the type's short name (`Foo::Page` -> `page`). Use this
  #             to disambiguate cross-namespace collisions (`Foo::Page` and
  #             `Bar::Page` in the same `types:` list) or to avoid clashes
  #             with existing methods on the host model.
  #
  # Compile-time errors:
  #   - `field` does not refer to a `:polymorphic` field on the host model.
  #   - Any entry in `types:` is not part of the polymorphic field's `to:` list.
  #   - Duplicate short names within `types:` without `as:` overrides.
  #   - An emitted alias would collide with an existing method/field on the host.
  #   - `as:` length does not match `types:` length.
  macro delegated_type(field, types, as _as = nil)
    {% raise "delegated_type: `types:` must be an ArrayLiteral, got #{types.class_name}" unless types.is_a?(ArrayLiteral) %}

    # M2: verify `field` refers to a polymorphic field on the host model.
    # Marten's polymorphic field always emits `def <field>_class` (and the
    # related `<field>_class!`); no other Marten field shape does. Using
    # that as the marker keeps the check self-contained — no need to walk
    # the registered-fields list at runtime.
    {% field_class_method_name = (field.id.stringify + "_class").id %}
    {%
      polymorphic_marker = @type.methods.find { |method| method.name == field_class_method_name }
    %}
    {% if polymorphic_marker == nil %}
      {% raise "delegated_type: `#{field.id}` is not a `:polymorphic` field on #{@type}. " \
               "Make sure `field :#{field.id}, :polymorphic, to: [...]` is declared before " \
               "`delegated_type :#{field.id}, types: [...]`." %}
    {% end %}

    # Extract the polymorphic field's `to:` list from the macro-emitted
    # `<field>_class` return type. Marten generates the union
    # `Type1.class | Type2.class | ... | Nil` for that method; parsing the
    # method's `return_type` as a string and dropping the trailing `.class`
    # / `Nil` parts gives us the authoritative `to:` list to validate
    # `types:` against. We work on the stringified union (rather than
    # `.resolve`-ing each part) because the user-declared `to:` types may
    # not be loaded yet when this macro expands — `.resolve` would raise
    # spuriously even though Marten's own polymorphic field handles the
    # AST without resolution.
    {%
      rt_str = polymorphic_marker.return_type.stringify
      to_names = [] of String
      rt_str.split(" | ").each do |part|
        if part.ends_with?(".class")
          to_names << part[0...-6]
        end
      end
    %}

    # M1: verify `types:` is a subset of the polymorphic field's `to:`.
    # Compare on stringified AST forms ("Leafables::Page") rather than
    # `.resolve`d type nodes — types referenced in `to:` may not have been
    # required by the time this macro expands, so resolution would error
    # spuriously even though Marten's own polymorphic field handled them
    # fine via unresolved AST insertion.
    {% for type in types %}
      {% unless to_names.includes?(type.stringify) %}
        {% raise "delegated_type: `#{type}` is not in the `to:` list of polymorphic field " \
                 "`#{field.id}` on #{@type}. Allowed: [#{to_names.join(", ").id}]." %}
      {% end %}
    {% end %}

    # Resolve alias list — default to `<type-short-name>.underscore`, with
    # optional per-position override via `as:`.
    {% if _as != nil %}
      {% raise "delegated_type: `as:` must be an ArrayLiteral, got #{_as.class_name}" unless _as.is_a?(ArrayLiteral) %}
      {% if _as.size != types.size %}
        {% raise "delegated_type: `as:` must have the same length as `types:` " \
                 "(got as: #{_as.size}, types: #{types.size})." %}
      {% end %}
    {% end %}

    {%
      aliases = [] of String
      types.each_with_index do |type, i|
        if _as != nil
          aliases << _as[i].id.stringify
        else
          aliases << type.stringify.split("::").last.underscore
        end
      end
    %}

    # Validate alias identifier shape. Each alias is interpolated directly
    # into emitted `def` names (`def <alias>`, `def <alias>?`, `def
    # self.<alias>s`); a non-identifier character like `-` would produce an
    # opaque "can't define def inside def" expansion trace instead of a
    # meaningful error. We only police `as:`-provided entries — the
    # default short-name path always goes through `.underscore` which
    # already yields a valid identifier shape.
    {% if _as != nil %}
      {% for alias_str, i in aliases %}
        {% unless alias_str =~ /\A[a-z_][a-z0-9_]*\z/i %}
          {% raise "delegated_type: as: entry '#{alias_str.id}' is not a valid Crystal identifier shape. " \
                   "Use snake_case alphanumeric + underscore." %}
        {% end %}
      {% end %}
    {% end %}

    # H2: detect duplicate short names within the `types:` list.
    {%
      seen = [] of String
      aliases.each do |alias_outer|
        if seen.includes?(alias_outer)
          dup_types = [] of String
          aliases.each_with_index do |alias_inner, dup_idx|
            dup_types << types[dup_idx].stringify if alias_inner == alias_outer
          end
          raise "delegated_type: duplicate short name `#{alias_outer.id}` derived from #{dup_types.join(" and ").id}. " \
                "Pass `as: [...]` to disambiguate, e.g. " \
                "`delegated_type :#{field.id}, types: [...], as: [\"page_a\", \"page_b\"]`."
        end
        seen << alias_outer
      end
    %}

    {% for type, i in types %}
      # `alias_name` is the host-facing method name (overridable via `as:`).
      # `delegate_short` is the Marten-derived short name used to call the
      # underlying polymorphic accessor (`<delegate_short>_<field>`).
      # These are typically equal but differ when the caller passes `as:`.
      {% alias_name = aliases[i].id %}
      {% delegate_short = type.stringify.split("::").last.underscore.id %}

      # H1: ensure the alias doesn't shadow an existing method on the host.
      # We walk `@type.ancestors.flat_map(&.methods)` (plus `@type.methods`
      # itself) rather than just `@type.methods` so the guard also catches
      # inherited methods and methods contributed by `include`d modules —
      # otherwise a host that does `include SneakyPage` (where `SneakyPage`
      # defines `def page`) would silently bypass the check. Direct host
      # methods + ancestor chain together cover the user's own `def page`,
      # any prior `delegated_type` contribution on this class, and anything
      # mixed in from a superclass or included module before this call.
      {%
        existing = @type.methods.find { |method| method.name.stringify == alias_name.stringify }
        if existing == nil
          @type.ancestors.each do |ancestor|
            if existing == nil
              existing = ancestor.methods.find { |method| method.name.stringify == alias_name.stringify }
            end
          end
        end
      %}
      {% if existing %}
        {% raise "delegated_type: cannot define `#{@type}##{alias_name}` — a method " \
                 "with that name already exists. Pass `as: [...]` to use a " \
                 "different alias, e.g. " \
                 "`delegated_type :#{field.id}, types: #{types}, as: [\"as_#{alias_name}\", ...]`." %}
      {% end %}

      # L2: explicit return-type annotation on the emitted accessor — lets
      # IDEs and `crystal docs` show the right signature without forcing
      # them to walk the delegation chain.
      def {{ alias_name }} : {{ type }}?
        {{ delegate_short }}_{{ field.id }}
      end

      # L3: the explicit `: ::Bool` is load-bearing. Without it, Crystal can
      # infer `Bool?` through the delegation chain because the polymorphic
      # field's `<field>?` traverses a nilable-getter branch. Pinning the
      # return type here matches Rails' `delegated_type` signature and is
      # exercised by the `::Bool`-typeof spec.
      def {{ alias_name }}? : ::Bool
        {{ delegate_short }}_{{ field.id }}?
      end

      # L1: pluralized class-level scope — Rails parity. Delegates to
      # Marten's `with_<delegate_short>_<field>` query helper.
      {% plural = (alias_name.stringify + "s").id %}
      def self.{{ plural }}
        with_{{ delegate_short }}_{{ field.id }}
      end
    {% end %}
  end
end
